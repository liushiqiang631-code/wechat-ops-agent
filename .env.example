# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=replace_with_a_random_local_secret
DATABASE_URL=sqlite:///./wechat_ops.db
OBJECT_STORAGE_PATH=./outputs
BUSINESS_TIMEZONE=Asia/Shanghai
OPERATOR_NAME=运营者

# DeepSeek V4 Pro
TEXT_MODEL_PROVIDER=deepseek
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=replace_with_deepseek_key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_OUTPUT_TOKENS=8192

# WeChat Official Account
WECHAT_ACCOUNT_NAME=
WECHAT_APP_ID=replace_with_wechat_app_id
WECHAT_APP_SECRET=replace_with_wechat_app_secret
WECHAT_ORIGINAL_ID=replace_with_original_id
WECHAT_API_BASE=https://api.weixin.qq.com
WECHAT_DRAFT_ENABLED=false

# Safety and budgets
IMAGE_MODEL_ENABLED=false
IMAGE_MODEL_PROVIDER=disabled
# AI 生图：阿里云百炼（DashScope）qwen-image-3.0-pro
DASHSCOPE_API_KEY=replace_with_dashscope_key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0-pro
DASHSCOPE_IMAGE_SIZE=1024*1024
DASHSCOPE_INTER_REQUEST_DELAY=60
# AI 生图备选：硅基流动（key 可放系统环境变量 SILICONFLOW_API_KEY）
# 可选模型（以 GET /models 实时列表为准）：
#   Tongyi-MAI/Z-Image-Turbo  约 ¥0.10/张，快速、写实（默认推荐）
#   Qwen/Qwen-Image           约 ¥0.25/张，擅长图内中文文字渲染
#   Kwai-Kolors/Kolors        免费
# 配置模型不可用时自动回退 Qwen/Qwen-Image
SILICONFLOW_API_KEY=replace_with_siliconflow_key
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
# Web image search for freely licensed images (Wikimedia Commons)
IMAGE_SEARCH_PROVIDER=disabled
# 联网搜索（Jina Reader x Bing，无需密钥）
WEB_SEARCH_PROVIDER=disabled
WEB_SEARCH_MAX_RESULTS=8
MAX_RESEARCH_QUERIES=8
MAX_SOURCES=20
MAX_REVIEW_ROUNDS=2
MAX_TOTAL_TOKENS=60000
AUTO_PUBLISH=false
ENABLE_INTENTIONAL_TYPOS=false
EXTERNAL_CONTENT_TRUST=untrusted
SCHEDULER_ENABLED=false

# MCP servers (see mcp_servers.example.json; the live file mcp_servers.json is gitignored)
MCP_SERVERS_PATH=./mcp_servers.json

